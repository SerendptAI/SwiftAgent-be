# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=swift_agent
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10

# Qdrant
QDRANT_URL=https://<your-cluster>.qdrant.tech
QDRANT_API_KEY=<your-api-key>
QDRANT_COLLECTION_NAME=knowledge_docs_gemini

# Google OAuth
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# JWT
SECRET_KEY=<your-secret-key>
REFRESH_SECRET_KEY=<your-refresh-secret-key>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
API_BASE_URL=http://localhost:8000
CONFIDENCE_THRESHOLD=0.7
REFERRAL_CODE=<your-referral-code>
ALLOWED_HOSTS=http://localhost:3000,https://swiftagents.org,https://www.swiftagents.org

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# File Uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# AI Models
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Blockchain Explorer (Etherscan API V2 — single key for all EVM chains)
ETHERSCAN_API_KEY=<your-etherscan-api-key>

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Fish.audio (voice STT/TTS)
FISH_AUDIO_API_KEY=<your-fish-audio-api-key>
FISH_AUDIO_VOICE_ID=<your-fish-audio-voice-id>

# Knowledge Base
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# Stroll (dashboard crawler)
STROLL_MAX_PAGES=50
STROLL_PAGE_TIMEOUT_MS=10000
STROLL_SCREENSHOT_QUALITY=70

# Pagination
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100
DEFAULT_CONVERSATION_LIMIT=50

# Context Window
MAX_CONTEXT_MESSAGES=10

# SendGrid (company email ticketing)
SENDGRID_API_KEY=<your-sendgrid-api-key>
EMAIL_DOMAIN=swfty.email

# OTP / credential auth (optional — shown with defaults)
OTP_TTL_SIGNUP_MINUTES=15
OTP_TTL_LOGIN_MINUTES=10
OTP_GRACE_PERIOD_DAYS=30
