# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=swift_agent
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10

# Qdrant
QDRANT_URL=https://<your-cluster>.qdrant.tech
QDRANT_API_KEY=<your-api-key>
QDRANT_COLLECTION_NAME=knowledge_docs_gemini

# Google OAuth
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# JWT
SECRET_KEY=<your-secret-key>
REFRESH_SECRET_KEY=<your-refresh-secret-key>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
API_BASE_URL=http://localhost:8000
CONFIDENCE_THRESHOLD=0.7
REFERRAL_CODE=<your-referral-code>
ALLOWED_HOSTS=http://localhost:3000,https://swiftagents.org,https://www.swiftagents.org,https://staging.swiftagents.org,https://www.staging.swiftagents.org

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# File Uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# AI Models
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENROUTER_API_KEY=<openrouter-api-key>
# Free models (append :free suffix). Good options with tool-calling support:
#   meta-llama/llama-3.3-70b-instruct:free
#   deepseek/deepseek-chat:free
#   google/gemma-3-27b-it:free
#   mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Blockchain Explorer (Etherscan API V2 — single key for all EVM chains)
ETHERSCAN_API_KEY=<your-etherscan-api-key>

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Fish.audio (voice STT/TTS)
FISH_AUDIO_API_KEY=<your-fish-audio-api-key>
FISH_AUDIO_VOICE_ID=<your-fish-audio-voice-id>

# Knowledge Base
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# Stroll (dashboard crawler)
STROLL_MAX_PAGES=50
STROLL_PAGE_TIMEOUT_MS=10000
STROLL_SCREENSHOT_QUALITY=70

# Pagination
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100
DEFAULT_CONVERSATION_LIMIT=50

# Context Window
MAX_CONTEXT_MESSAGES=10

# SendGrid (company email ticketing)
SENDGRID_API_KEY=<your-sendgrid-api-key>
EMAIL_DOMAIN=swfty.email

# OTP / credential auth (optional — shown with defaults)
OTP_TTL_SIGNUP_MINUTES=15
OTP_TTL_LOGIN_MINUTES=10
OTP_GRACE_PERIOD_DAYS=30

# Polar — African pricing (existing products)
POLAR_PRODUCT_BASIC_AF=76c6aab0-e9df-4528-b418-e16aa70abba5
POLAR_PRODUCT_PRO_AF=9e6e7deb-a5e4-40b0-ad8e-1106a3d3a76c
POLAR_PRODUCT_ENTERPRISE_AF=bb76d48f-e41e-4a16-9a33-1ee1c0f4786f
# Polar — International pricing
POLAR_PRODUCT_BASIC_INTL=52c04072-a8a6-4ad7-a999-374079acbfd1
POLAR_PRODUCT_PRO_INTL=8ff00348-f76a-4b5a-afd0-207e39ba910e
POLAR_PRODUCT_ENTERPRISE_INTL=5d3eca44-241f-43cd-a4c7-bc2a00f0ffd4
# Discount auto-applied to International Basic (50% off $200 → $100)
POLAR_DISCOUNT_BASIC_INTL=845c8f40-0c9b-4743-8abb-c5bc944ff829

# Pagination
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100
DEFAULT_CONVERSATION_LIMIT=50

# Context Window
MAX_CONTEXT_MESSAGES=10

# SendGrid (company email ticketing)
SENDGRID_API_KEY=<your-sendgrid-api-key>
EMAIL_DOMAIN=swfty.email

# OTP / credential auth (optional — shown with defaults)
OTP_TTL_SIGNUP_MINUTES=15
OTP_TTL_LOGIN_MINUTES=10
OTP_GRACE_PERIOD_DAYS=30

# Web Push Notifications (VAPID)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:team@swiftagents.org


# ZeptoMail SMTP
ZEPTO_SMTP_PASSWORD=
ZEPTO_SMTP_USERNAME=emailapikey
ZEPTO_SENDER_EMAIL=noreply@swiftagents.org
ZEPTO_SMTP_PORT=465
ZEPTO_SMTP_SERVER=smtp.zeptomail.com

# Email Provider toggle
EMAIL_PROVIDER=zepto

# ── LLM Observability (Langfuse) ─────────────────────────────────────────────
# Get keys from https://cloud.langfuse.com  OR  your self-hosted instance.
# Leave blank to disable observability (the app still runs normally).
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxx
# Self-hosted URL (e.g. https://langfuse.yourdomain.com). Default = Langfuse cloud.
LANGFUSE_HOST=https://cloud.langfuse.com
