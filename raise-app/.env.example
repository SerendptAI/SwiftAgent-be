# Raise App Configuration
# ========================

# App secret for session / login
RAISE_APP_PASSWORD=your_login_password_here
SECRET_KEY=generate_a_random_key_here

# SMTP Configuration (Zoho)
SMTP_SERVER=smtp.zoho.com
SMTP_PORT=465
SMTP_EMAIL=raise@swiftagents.org
SMTP_PASSWORD=your_zoho_app_password_here

# App Settings
APP_HOST=0.0.0.0
APP_PORT=8500
APP_ENV=production

# Data
VC_FILE_PATH=data/VC.xlsx

# MongoDB (for tracking email sends)
MONGO_URI=your_mongo_uri_here
MONGO_DB_NAME=SwiftAgentsDB
